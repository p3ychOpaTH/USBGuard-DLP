# ---------------------------------------------------------------------------
# Configuration manager with optional encryption
# ---------------------------------------------------------------------------
class Config:
    def __init__(self, config_path: Path = Path("C:\\ProgramData\\USBGuard\\config.ini")):
        self.config_path = config_path
        self.raw_config = configparser.ConfigParser()
        self.encryption_key: Optional[bytes] = None

        # Defaults
        self.defaults = {
            "shadow_copy_folder": "C:\\ProgramData\\USBGuard\\ShadowVault",
            "allow_unknown_devices": False,
            "shadow_enabled": True,
            "shadow_file_max_size_mb": 50,
            "polling_interval_sec": 2.0,
            "event_log_id_base": 1000,
            "device_allowlist": {},  # serial: alias
            "vendor_allowlist": [],  # vid strings
            "product_allowlist": [],
            "class_allowlist": ["DiskDrive"],  # usually allow disk drives
        }
        self.load()

    def load(self):
        if not self.config_path.exists():
            self._create_default_config()
            self.raw_config.read(self.config_path)
        else:
            self.raw_config.read(self.config_path)
        # Load encryption key from registry
        self.encryption_key = self._get_registry_key()
        self._decrypt_if_needed()
        # Parse settings with defaults
        self.shadow_copy_folder = self._get_str("Shadow", "shadow_copy_folder", self.defaults["shadow_copy_folder"])
        self.allow_unknown = self._get_bool("Policy", "allow_unknown_devices", self.defaults["allow_unknown_devices"])
        self.shadow_enabled = self._get_bool("Shadow", "shadow_enabled", self.defaults["shadow_enabled"])
        self.max_file_size_mb = self._get_int("Shadow", "shadow_file_max_size_mb", self.defaults["shadow_file_max_size_mb"])
        self.polling_interval = self._get_float("General", "polling_interval_sec", self.defaults["polling_interval_sec"])
        self.event_base = self._get_int("Logging", "event_log_id_base", self.defaults["event_log_id_base"])
        # Load allowlists
        self._load_allowlists()
        event_logger.log("info", "Configuration loaded successfully")

    def _create_default_config(self):
        self.config_path.parent.mkdir(parents=True, exist_ok=True)
        config = configparser.ConfigParser()
        config["General"] = {"polling_interval_sec": "2.0"}
        config["Policy"] = {"allow_unknown_devices": "False"}
        config["Shadow"] = {
            "shadow_copy_folder": self.defaults["shadow_copy_folder"],
            "shadow_enabled": "True",
            "shadow_file_max_size_mb": "50",
        }
        config["Logging"] = {"event_log_id_base": "1000"}
        config["Allowlist_Devices"] = {}  # serial=alias
        config["Allowlist_Vendors"] = []
        config["Allowlist_Products"] = []
        config["Allowlist_Classes"] = self.defaults["class_allowlist"]
        with open(self.config_path, "w") as f:
            config.write(f)

    def _get_registry_key(self) -> Optional[bytes]:
        try:
            import winreg
            with winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, REG_PATH) as key:
                value, _ = winreg.QueryValueEx(key, REG_KEY_NAME)
                return value.encode()
        except Exception:
            return None

    def _decrypt_if_needed(self):
        if not Fernet:
            return
        # Encrypted sections start with 'ENC_'
        for section in self.raw_config.sections():
            if section.startswith("ENC_"):
                original_section = section[4:]
                if self.encryption_key:
                    try:
                        f = Fernet(self.encryption_key)
                        for key, value in self.raw_config[section].items():
                            decrypted = f.decrypt(value.encode()).decode()
                            if not self.raw_config.has_section(original_section):
                                self.raw_config.add_section(original_section)
                            self.raw_config[original_section][key] = decrypted
                    except Exception as e:
                        event_logger.log("warning", f"Failed to decrypt section {section}: {e}")

    def _load_allowlists(self):
        # Device serials
        self.device_allowlist = {}
        if self.raw_config.has_section("Allowlist_Devices"):
            for serial, alias in self.raw_config.items("Allowlist_Devices"):
                self.device_allowlist[serial.upper()] = alias
        # Vendors
        self.vendor_allowlist = self._get_list("Allowlist_Vendors", "vendor_ids")
        # Products
        self.product_allowlist = self._get_list("Allowlist_Products", "product_ids")
        # Classes
        self.class_allowlist = self._get_list("Allowlist_Classes", "classes")

    def _get_str(self, section, key, default) -> str:
        return self.raw_config.get(section, key, fallback=default)

    def _get_bool(self, section, key, default) -> bool:
        return self.raw_config.getboolean(section, key, fallback=default)

    def _get_int(self, section, key, default) -> int:
        return self.raw_config.getint(section, key, fallback=default)

    def _get_float(self, section, key, default) -> float:
        return self.raw_config.getfloat(section, key, fallback=default)

    def _get_list(self, section, key) -> List[str]:
        raw = self.raw_config.get(section, key, fallback="")
        if not raw:
            return []
        return [item.strip() for item in raw.split(",") if item.strip()]

    def is_device_allowed(self, serial: str, vid: str, pid: str, device_class: str) -> bool:
        # Check class first (broadest)
        if device_class in self.class_allowlist:
            return True
        # Check vendor/product
        if vid and pid:
            if vid in self.vendor_allowlist or pid in self.product_allowlist:
                return True
        # Serial
        if serial and serial.upper() in self.device_allowlist:
            return True
        # Fallback policy
        return self.allow_unknown


# ---------------------------------------------------------------------------
# USB Device management (WMI + SetupAPI)
# ---------------------------------------------------------------------------
class USBManager:
    """Utility class to interact with USB storage devices."""
    def __init__(self):
        self.wmi_conn = wmi.WMI()

    def get_usb_storage_devices(self) -> List[Dict]:
        """Returns list of USB mass storage devices with relevant properties."""
        devices = []
        try:
            # Win32_DiskDrive with InterfaceType='USB'
            for disk in self.wmi_conn.Win32_DiskDrive(InterfaceType="USB"):
                dev = {
                    "name": disk.Caption,
                    "model": disk.Model,
                    "serial": disk.SerialNumber.strip() if disk.SerialNumber else "",
                    "vendor_id": disk.PNPDeviceID.split("\\")[1] if "\\" in disk.PNPDeviceID else "",
                    "product_id": "",  # we'll extract later
                    "class": "DiskDrive",
                    "pnp_device_id": disk.PNPDeviceID,
                    "status": disk.Status,
                }
                # Extract VID/PID from PNPDeviceID (USB\VID_xxxx&PID_xxxx\...)
                if "VID_" in disk.PNPDeviceID:
                    parts = disk.PNPDeviceID.split("\\")
                    for part in parts:
                        if part.startswith("VID_"):
                            dev["vendor_id"] = part.split("&")[0].split("_")[1]
                        if "PID_" in part:
                            dev["product_id"] = part.split("&")[1].split("_")[1]
                devices.append(dev)
        except Exception as e:
            event_logger.log("error", f"WMI query for USB drives failed: {e}")
        return devices

    def disable_device(self, pnp_device_id: str) -> bool:
        """Disable the device using WMI PnPEntity.Disable()."""
        try:
            pnp_entity = self.wmi_conn.Win32_PnPEntity(DeviceID=pnp_device_id)
            if pnp_entity:
                res = pnp_entity[0].Disable()
                if res[0] == 0:
                    event_logger.log("info", f"Device disabled: {pnp_device_id}")
                    return True
                else:
                    event_logger.log("error", f"Disable failed for {pnp_device_id}, return {res[0]}")
            else:
                event_logger.log("warning", f"No PnPEntity found for {pnp_device_id}")
        except Exception as e:
            event_logger.log("error", f"Exception disabling device: {e}")
        return False

    def enable_device(self, pnp_device_id: str) -> bool:
        """Re‑enable a disabled device."""
        try:
            pnp_entity = self.wmi_conn.Win32_PnPEntity(DeviceID=pnp_device_id)
            if pnp_entity:
                res = pnp_entity[0].Enable()
                if res[0] == 0:
                    event_logger.log("info", f"Device enabled: {pnp_device_id}")
                    return True
        except Exception:
            pass
        return False

    def get_device_class(self, pnp_device_id: str) -> str:
        """Extract device class GUID from PnP entity."""
        try:
            pnp = self.wmi_conn.Win32_PnPEntity(DeviceID=pnp_device_id)
            if pnp:
                return pnp[0].ClassGuid or "Unknown"
        except Exception:
            pass
        return "Unknown"


# ---------------------------------------------------------------------------
# Shadow Copy Engine (forensic integrity)
# ---------------------------------------------------------------------------
class ShadowCopyWorker:
    """Watches a mounted USB drive and silently copies all new/changed files
    to the vault while preserving directory structure and timestamps."""
    def __init__(self, config: Config, event_log: DLP_EventLogger):
        self.config = config
        self.log = event_log
        self.active_tasks: Dict[str, threading.Thread] = {}  # drive_letter -> thread
        self.stop_events: Dict[str, threading.Event] = {}

    def start_watching(self, drive_letter: str, target_root: Path):
        if drive_letter in self.active_tasks:
            return
        stop_event = threading.Event()
        self.stop_events[drive_letter] = stop_event
        t = threading.Thread(
            target=self._watcher_loop,
            args=(drive_letter, target_root, stop_event),
            daemon=True,
        )
        self.active_tasks[drive_letter] = t
        t.start()
        self.log.log("info", f"Shadow copy started for {drive_letter} -> {target_root}")

    def stop_watching(self, drive_letter: str):
        if drive_letter in self.stop_events:
            self.stop_events[drive_letter].set()
        if drive_letter in self.active_tasks:
            t = self.active_tasks.pop(drive_letter)
            t.join(timeout=5.0)
            self.log.log("info", f"Shadow copy stopped for {drive_letter}")

    def _watcher_loop(self, drive_letter: str, vault_base: Path, stop_event: threading.Event):
        source_root = Path(f"{drive_letter}\\")
        if not source_root.exists():
            self.log.log("error", f"Drive {drive_letter} not accessible for shadowing")
            return
        known_files: Dict[str, Tuple[float, int]] = self._snapshot_files(source_root)
        while not stop_event.is_set():
            try:
                current_files = self._snapshot_files(source_root)
                # New or modified files
                for path_str, (mtime, size) in current_files.items():
                    if path_str not in known_files or known_files[path_str] != (mtime, size):
                        src = Path(path_str)
                        # Size limit
                        if size > self.config.max_file_size_mb * 1024 * 1024:
                            self.log.log("warning", f"File too large for shadow copy: {path_str} ({size} bytes)")
                            continue
                        # Shadow copy
                        rel = src.relative_to(source_root)
                        dest = vault_base / rel
                        self._safe_copy(src, dest, mtime)
                # Removed files? Do nothing (forensic preservation)
                known_files = current_files
            except Exception as e:
                self.log.log("error", f"Shadow worker error on {drive_letter}: {traceback.format_exc()}")
            time.sleep(1.0)

    def _snapshot_files(self, root: Path) -> Dict[str, Tuple[float, int]]:
        snapshot = {}
        try:
            for entry in root.rglob("*"):
                if entry.is_file():
                    stat = entry.stat()
                    snapshot[str(entry)] = (stat.st_mtime, stat.st_size)
        except Exception:
            pass
        return snapshot

    def _safe_copy(self, src: Path, dest: Path, mtime: float):
        try:
            dest.parent.mkdir(parents=True, exist_ok=True)
            # Use Windows API to copy with metadata
            win32file.CopyFile(str(src), str(dest), False)
            # Set last modification time
            os.utime(dest, (mtime, mtime))
        except Exception as e:
            self.log.log("warning", f"Shadow copy failed for {src}: {e}")


# ---------------------------------------------------------------------------
# Real‑time device monitor (WMI events + polling)
# ---------------------------------------------------------------------------
class DeviceMonitor(threading.Thread):
    """Continuously detects USB storage arrival, enforces policy."""

    def __init__(self, config: Config, usb_mgr: USBManager, shadow: ShadowCopyWorker, stop_event: threading.Event):
        super().__init__(daemon=True)
        self.config = config
        self.usb = usb_mgr
        self.shadow = shadow
        self.stop_event = stop_event
        self.known_devices: Set[str] = set()  # serial numbers of currently active allowed devices
        self.device_drive_letters: Dict[str, List[str]] = {}  # serial -> [letters]

    def run(self):
        event_logger.log("info", "Device monitor thread started")
        # Primary method: WMI event watcher for Win32_USBControllerDevice
        watcher = threading.Thread(target=self._wmi_event_watcher, daemon=True)
        watcher.start()
        # Fallback polling loop
        while not self.stop_event.is_set():
            try:
                self._poll_and_process()
            except Exception as e:
                event_logger.log("error", f"Poll loop error: {e}")
            time.sleep(self.config.polling_interval)

    def _wmi_event_watcher(self):
        """Listens for new USB devices using WMI event query."""
        try:
            c = wmi.WMI()
            watcher = c.watch_for(
                raw_wql="SELECT * FROM Win32_DeviceChangeEvent WITHIN 1 WHERE TargetInstance ISA 'Win32_DiskDrive'"
            )
            while not self.stop_event.is_set():
                try:
                    event = watcher(timeout_ms=1000)
                    if event:
                        event_logger.log("info", f"WMI event: {event}")
                        self._poll_and_process()  # immediate re‑evaluation
                except pywintypes.com_error as e:
                    if self.stop_event.is_set():
                        break
                    time.sleep(0.5)
        except Exception as e:
            event_logger.log("error", f"WMI watcher failed: {e}")

    def _poll_and_process(self):
        devices = self.usb.get_usb_storage_devices()
        current_serials = set()
        for dev in devices:
            serial = dev["serial"] or dev["pnp_device_id"]  # fallback to PNP ID if no serial
            current_serials.add(serial)
            # Newly seen device?
            if serial not in self.known_devices:
                self._evaluate_device(dev, serial)
            else:
                # Device still present, ensure drives are still shadowed
                self._refresh_drive_letters(serial, dev)
        # Handle removal: devices that were known but not in current scan
        removed = self.known_devices - current_serials
        for serial in removed:
            event_logger.log("info", f"Device removed: {serial}")
            self._remove_device(serial)
        self.known_devices = current_serials

    def _evaluate_device(self, dev: Dict, serial: str):
        event_logger.log("info", f"New USB device detected: {dev['name']} (Serial: {serial}, VID: {dev['vendor_id']}, PID: {dev['product_id']})")
        allowed = self.config.is_device_allowed(
            serial=serial,
            vid=dev["vendor_id"],
            pid=dev["product_id"],
            device_class=dev.get("class", ""),
        )
        if not allowed:
            event_logger.log("warning", f"Unauthorized device: {serial}. Disabling...")
            self._disable_and_alert(dev)
        else:
            event_logger.log("info", f"Authorized device: {serial}. Starting shadow copy...")
            self.known_devices.add(serial)
            self._refresh_drive_letters(serial, dev)

    def _disable_and_alert(self, dev: Dict):
        success = self.usb.disable_device(dev["pnp_device_id"])
        if success:
            # Also attempt to unmount logical drives for this disk
            self._remove_drive_letters(dev["pnp_device_id"])
            event_logger.log("warning", f"Unauthorized USB device disabled: {dev['name']}", event_id=self.config.event_base + 1)
        else:
            event_logger.log("error", f"Failed to disable unauthorized device {dev['name']}", event_id=self.config.event_base + 2)

    def _remove_drive_letters(self, pnp_device_id: str):
        """Remove drive letters associated with a disk, using WMI association."""
        try:
            for disk in self.usb.wmi_conn.Win32_DiskDrive(PNPDeviceID=pnp_device_id):
                for partition in disk.associators(wmi_result_class="Win32_DiskPartition"):
                    for logical_disk in partition.associators(wmi_result_class="Win32_LogicalDisk"):
                        letter = logical_disk.DeviceID
                        if letter and letter[1] == ":":
                            cmd = f"mountvol {letter} /d"
                            subprocess.run(cmd, shell=True, capture_output=True)
                            event_logger.log("info", f"Removed drive letter {letter}")
        except Exception as e:
            event_logger.log("warning", f"Could not remove drive letters: {e}")

    def _refresh_drive_letters(self, serial: str, dev: Dict):
        """Query logical disks and start/restart shadow copy on all partitions."""
        letters = []
        try:
            for disk in self.usb.wmi_conn.Win32_DiskDrive(PNPDeviceID=dev["pnp_device_id"]):
                for partition in disk.associators(wmi_result_class="Win32_DiskPartition"):
                    for logical_disk in partition.associators(wmi_result_class="Win32_LogicalDisk"):
                        letter = logical_disk.DeviceID
                        if letter and letter[1] == ":":
                            letters.append(letter)
            self.device_drive_letters[serial] = letters
            if self.config.shadow_enabled:
                vault = Path(self.config.shadow_copy_folder) / serial
                for letter in letters:
                    self.shadow.start_watching(letter, vault / letter.strip(":\\"))
        except Exception:
            pass

    def _remove_device(self, serial: str):
        """Stop shadow copy and clean up."""
        letters = self.device_drive_letters.pop(serial, [])
        for letter in letters:
            self.shadow.stop_watching(letter)
        # We never automatically re‑enable a device here, because policy might have changed.
        # A separate re‑enable script can be used by admins.

