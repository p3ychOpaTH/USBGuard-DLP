class DLP_EventLogger:
    """Writes to both Windows Event Log (Application) and a rotating debug file."""
    _evt_src = "USBGuard"
    _initialized = False

    def __init__(self, log_file: Path = Path("C:\\ProgramData\\USBGuard\\usbguard.log")):
        self.log_file = log_file
        self.file_logger = None
        self._setup_file_log()
        self._register_event_source()

    def _setup_file_log(self):
        self.log_file.parent.mkdir(parents=True, exist_ok=True)
        self.file_logger = logging.getLogger("usbguard_file")
        self.file_logger.setLevel(logging.DEBUG)
        handler = logging.handlers.RotatingFileHandler(
            self.log_file, maxBytes=5 * 1024 * 1024, backupCount=5
        )
        formatter = logging.Formatter(
            "%(asctime)s [%(levelname)s] %(name)s: %(message)s",
            datefmt="%Y-%m-%d %H:%M:%S",
        )
        handler.setFormatter(formatter)
        self.file_logger.addHandler(handler)

    def _register_event_source(self):
        global event_logger
        try:
            win32evtlog.RegisterEventSource(None, self._evt_src)
            self._initialized = True
        except Exception as e:
            self.file_logger.warning(f"Cannot register event source (running as non‑admin?): {e}")

    def log(self, level: str, message: str, event_id: int = 1000):
        if self.file_logger:
            getattr(self.file_logger, level.lower(), self.file_logger.info)(message)
        # Windows Event Log
        if self._initialized:
            try:
                h = win32evtlog.RegisterEventSource(None, self._evt_src)
                if h:
                    win32evtlog.ReportEvent(
                        h,
                        {
                            "info": win32evtlog.EVENTLOG_INFORMATION_TYPE,
                            "warning": win32evtlog.EVENTLOG_WARNING_TYPE,
                            "error": win32evtlog.EVENTLOG_ERROR_TYPE,
                        }.get(level.lower(), win32evtlog.EVENTLOG_INFORMATION_TYPE),
                        0,
                        event_id,
                        None,
                        [message],
                    )
                    win32evtlog.DeregisterEventSource(h)
            except Exception:
                pass


